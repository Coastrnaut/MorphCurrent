# Python / local environment
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
# GPU outputs and user media — never in Git
outputs/
cache/
logs/
checkpoints/
models/
*.safetensors
*.ckpt
*.pt
*.pth
*.onnx
*.gguf
*.mp4
*.mov
*.webm
*.wav
*.flac
*.mp3
*.png
*.jpg
*.jpeg
# Generated media stay out of Git.
# secrets / local approvals
.env
.env.*
!.env.example
.claude/settings.local.json
*.key
*.pem
# imported workflow exports may contain local node maps, but default templates are tracked
# avoid committing machine-only settings
configs/local/

# Local backups of Spec Kit before regenerated Python-only scaffolding
.local/

# Editor settings (personal)
.vscode/
.idea/

# Owner-approved public-domain/CC0 music with provenance JSON (see assets/music/README.md)
!assets/music/*.opus
